---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Asiimwe Ronald">
  <main id="main" class="flex min-h-screen items-center justify-center px-6">
    <div class="text-center">
      <h1 class="text-6xl font-bold">404</h1>
      <p class="mt-4 text-[var(--color-muted)]">The page you are looking for does not exist.</p>
      <a href="/" class="mt-6 inline-block text-[var(--color-accent)] underline">Return home</a>
    </div>
  </main>
</BaseLayout>
