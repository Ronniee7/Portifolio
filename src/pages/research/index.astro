---
import { getCollection } from 'astro:content';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Badge from '../../components/ui/Badge.astro';
import Card from '../../components/ui/Card.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const researchEntries = await getCollection('research');

const statusLabels: Record<string, { label: string; variant: 'default' | 'accent' | 'muted' | 'outline' }> = {
  ongoing: { label: 'Ongoing', variant: 'accent' },
  planned: { label: 'Planned', variant: 'muted' },
  completed: { label: 'Completed', variant: 'default' },
};

const typeLabels: Record<string, string> = {
  project: 'Research Project',
  interest: 'Research Interest',
};
---
<BaseLayout title="Research — Asiimwe Ronald" description="Research projects and interests of Asiimwe Ronald.">
  <main id="main">
    <Section id="research">
      <Container size="lg">
        <SectionHeading
          eyebrow="Research"
          title="Research and academic work."
          description="Ongoing and planned research in applied machine learning, responsible AI, and intelligent energy systems."
        />

        <div class="mb-12">
          <h3 class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)] mb-6">Research interests</h3>
          <div class="flex flex-wrap gap-3">
            <Badge variant="muted">Reliable machine learning</Badge>
            <Badge variant="muted">Limited labelled data</Badge>
            <Badge variant="muted">Robustness and distribution shift</Badge>
            <Badge variant="muted">Model evaluation</Badge>
            <Badge variant="muted">Applied machine learning</Badge>
            <Badge variant="muted">Generative AI</Badge>
            <Badge variant="muted">Responsible AI</Badge>
            <Badge variant="muted">Intelligent energy systems</Badge>
          </div>
        </div>

        <div class="mb-12">
          <h3 class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)] mb-6">Featured research</h3>
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            {researchEntries
              .filter((e) => e.data.featured && e.data.type === 'project')
              .map((entry) => {
                const data = entry.data;
                const statusInfo = statusLabels[data.status] ?? statusLabels.ongoing;
                return (
                  <Card variant="elevated" class="flex flex-col h-full">
                    <div class="flex-1">
                      <div class="flex gap-2 mb-4">
                        <Badge variant={statusInfo.variant} class="text-xs">{statusInfo.label}</Badge>
                        <Badge variant="outline" class="text-xs">{typeLabels[data.type]}</Badge>
                      </div>
                      <h3 class="text-lg font-semibold text-[var(--color-fg)] mb-2">{data.title}</h3>
                      <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed mb-4">{data.description}</p>
                      {data.supervisor && (
                        <p class="text-xs text-[var(--color-fg-subtle)] mb-4">
                          Supervisor: {data.supervisor} · {data.institution}
                        </p>
                      )}
                      <div class="flex flex-wrap gap-2 mb-6">
                        {data.technologies.map((tech) => (
                          <Badge variant="outline" key={tech} class="text-xs">{tech}</Badge>
                        ))}
                      </div>
                    </div>
                    <a
                      href={"/research/" + entry.id}
                      class="mt-auto inline-flex items-center gap-2 text-sm text-[var(--color-accent)] hover:underline font-medium"
                    >
                      View research <span aria-hidden="true">→</span>
                    </a>
                  </Card>
                );
              })}
          </div>
        </div>
        <div class="mb-12">
          <h3 class="text-sm uppercase tracking-widest text-[var(--color-fg-subtle)] mb-6">All research</h3>
          <div class="space-y-6">
            {researchEntries.map((entry) => {
              const data = entry.data;
              const statusInfo = statusLabels[data.status] ?? statusLabels.ongoing;
              return (
                <Card key={entry.id} variant="default" class="flex flex-col gap-4 p-6">
                  <div>
                    <div class="flex flex-wrap gap-2 mb-2">
                      <Badge variant={statusInfo.variant} class="text-xs">{statusInfo.label}</Badge>
                      <Badge variant="outline" class="text-xs">{typeLabels[data.type]}</Badge>
                    </div>
                    <h3 class="text-lg font-semibold text-[var(--color-fg)]">{data.title}</h3>
                    <p class="mt-2 text-sm text-[var(--color-fg-muted)] leading-relaxed">{data.description}</p>
                  </div>
                  <div class="border-t border-[var(--color-border)] pt-4">
                    <div class="flex flex-wrap gap-2 mb-3">
                      {data.technologies.map((tech) => (
                        <Badge variant="outline" key={tech} class="text-xs">{tech}</Badge>
                      ))}
                    </div>
                    <a
                      href={"/research/" + entry.id}
                      class="inline-flex items-center gap-2 text-sm text-[var(--color-accent)] hover:underline font-medium"
                    >
                      Read more <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </Card>
              );
            })}
          </div>
        </div>

        {researchEntries.length === 0 && (
          <p class="text-[var(--color-fg-muted)]">No research entries yet. Add Markdown files to <code class="mono">src/content/research/</code>.</p>
        )}
      </Container>
    </Section>
  </main>
</BaseLayout>
