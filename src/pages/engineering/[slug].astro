---
import { getCollection, render } from 'astro:content';
import Container from '../../components/ui/Container.astro';
import Section from '../../components/ui/Section.astro';
import Badge from '../../components/ui/Badge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = await getCollection('engineering');

export async function getStaticPaths() {
  const allEntries = await getCollection('engineering');
  return allEntries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const entry = entries.find((e) => e.id === Astro.params.slug);

if (!entry) {
  return new Response(null, { status: 404 });
}

const { Content } = await render(entry);
const data = entry.data;

const statusLabels: Record<string, { label: string; variant: 'default' | 'accent' | 'muted' | 'outline' }> = {
  implemented: { label: 'Implemented', variant: 'default' },
  'research-prototype': { label: 'Research Prototype', variant: 'outline' },
  proposed: { label: 'Proposed', variant: 'muted' },
  'in-progress': { label: 'In Progress', variant: 'accent' },
};

const categoryLabels: Record<string, string> = {
  philosophy: 'Engineering Philosophy',
  backend: 'Backend Engineering',
  devops: 'DevOps & Quality',
  'ml-engineering': 'ML Engineering',
  'ai-applications': 'AI Applications',
  'energy-systems': 'Intelligent Energy Systems',
  architecture: 'Architecture',
  practices: 'Standards & Practices',
};

const statusInfo = statusLabels[data.status] ?? statusLabels.implemented;
---

<BaseLayout title={data.title + ' — Engineering Lab — Asiimwe Ronald'} description={data.description}>
  <main id="main">
    <Section class="py-8 sm:py-12 lg:py-16">
      <Container size="lg">
        <div class="mb-8">
          <a href="/engineering" class="inline-flex items-center gap-2 text-sm text-[var(--color-accent)] hover:underline mb-3">
            ← Back to Engineering Lab
          </a>
          <div class="flex flex-wrap gap-2 mb-4">
            <Badge variant={statusInfo.variant} class="text-xs">{statusInfo.label}</Badge>
            <Badge variant="outline" class="text-xs">{categoryLabels[data.category] ?? data.category}</Badge>
          </div>
          <h1 class="display text-3xl sm:text-4xl text-[var(--color-fg)]">{data.title}</h1>
          <p class="mt-4 text-lg text-[var(--color-fg-muted)] leading-relaxed">{data.description}</p>
        </div>

        <article class="prose-lg space-y-8">
          <Content />
        </article>
      </Container>
    </Section>
  </main>
</BaseLayout>
