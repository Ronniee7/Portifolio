---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Experience from '../components/sections/Experience.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
---

<BaseLayout>
  <main id="main">
    <Hero />
    <About />
    <Experience />

    <Section id="projects">
      <Container>
        <SectionHeading eyebrow="Projects" title="Selected work." description="Project gallery coming in Phase 4." />
      </Container>
    </Section>

    <Section id="research">
      <Container>
        <SectionHeading eyebrow="Research" title="Research and publications." description="Research section coming in Phase 5." />
      </Container>
    </Section>

    <Section id="engineering">
      <Container>
        <SectionHeading eyebrow="Engineering" title="Engineering laboratory." description="Engineering lab coming in Phase 6." />
      </Container>
    </Section>

    <Section id="writing">
      <Container>
        <SectionHeading eyebrow="Writing" title="Technical writing." description="Writing section coming in Phase 5." />
      </Container>
    </Section>

    <Section id="contact">
      <Container>
        <SectionHeading eyebrow="Contact" title="Get in touch." description="Contact section coming in Phase 8." />
      </Container>
    </Section>
  </main>
</BaseLayout>
