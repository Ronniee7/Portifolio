---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Experience from '../components/sections/Experience.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout>
  <main id="main">
    <Hero />
    <About />
    <Experience />

    <Section id="projects">
      <Container>
        <SectionHeading
          eyebrow="Projects"
          title="Selected work."
          description="A curated selection of software engineering, machine learning, AI, and research projects."
        />
        <p class="mt-6 text-[var(--color-fg-muted)]">
          View the full project gallery with filters and detailed case studies.
        </p>
        <div class="mt-6">
          <Button href="/projects" variant="primary" size="md">View all projects</Button>
        </div>
      </Container>
    </Section>

    <Section id="research">
      <Container>
        <SectionHeading
          eyebrow="Research"
          title="Research and publications."
          description="Ongoing research in applied machine learning, responsible AI, and intelligent energy systems."
        />
        <p class="mt-6 text-[var(--color-fg-muted)]">
          Explore current research directions and verified publications.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/research" class="text-sm text-[var(--color-accent)] hover:underline font-medium">View all research</a>
          <a href="/publications" class="text-sm text-[var(--color-accent)] hover:underline font-medium">View publications</a>
        </div>
      </Container>
    </Section>

    <Section id="engineering">
      <Container>
        <SectionHeading eyebrow="Engineering" title="Engineering laboratory." description="Technical deep dives, system architecture, and engineering practices." />
        <p class="mt-6 text-[var(--color-fg-muted)]">
          Explore backend engineering, DevOps and quality, machine learning engineering, AI application architecture, and intelligent energy systems.
        </p>
        <div class="mt-6">
          <Button href="/engineering" variant="primary" size="md">Open engineering lab</Button>
        </div>
      </Container>
    </Section>

    <Section id="writing">
      <Container>
        <SectionHeading eyebrow="Writing" title="Technical writing." description="Writing section coming in Phase 5." />
      </Container>
    </Section>

    <Section id="contact">
      <Container>
        <SectionHeading eyebrow="Contact" title="Get in touch." description="Contact section coming in Phase 8." />
      </Container>
    </Section>
  </main>
</BaseLayout>
