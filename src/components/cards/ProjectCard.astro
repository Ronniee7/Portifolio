---
interface Props {
  title: string;
  description: string;
  category: string;
  status: string;
  technologies: string[];
  image?: string;
  href: string;
  githubUrl?: string;
  liveUrl?: string;
  class?: string;
}

const statusConfig: Record<string, { label: string; variant: 'default' | 'accent' | 'muted' | 'outline' }> = {
  completed: { label: 'Completed', variant: 'default' },
  'in-development': { label: 'In Development', variant: 'accent' },
  planned: { label: 'Planned', variant: 'muted' },
  'research-prototype': { label: 'Research Prototype', variant: 'outline' },
};

const {
  title,
  description,
  category,
  status,
  technologies = [],
  image,
  href,
  githubUrl,
  liveUrl,
  class: className = '',
} = Astro.props;

const statusInfo = statusConfig[status] ?? statusConfig.completed;
const linkCount = [href, githubUrl, liveUrl].filter(Boolean).length;
---

<article
  data-category={category}
  class={[
    'project-card rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-colors hover:border-[var(--color-border-strong)] hover:shadow-[var(--shadow-md)]',
    className,
  ]
    .filter(Boolean)
    .join(' ')}
>
  {image && (
    <div class="mb-4 rounded-[var(--radius-lg)] overflow-hidden border border-[var(--color-border)] bg-[var(--color-bg-elevated)] aspect-[4/3]">
      <img
        src={image}
        alt={title}
        width="400"
        height="300"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover"
      />
    </div>
  )}
  <div class="flex flex-wrap justify-between items-start gap-2 mb-3">
    <Badge variant="muted" class="text-xs">{category}</Badge>
    <Badge variant={statusInfo.variant} class="text-xs">{statusInfo.label}</Badge>
  </div>
  <h3 class="text-lg font-semibold text-[var(--color-fg)] mb-2 leading-snug">{title}</h3>
  <p class="text-sm text-[var(--color-fg-muted)] leading-relaxed mb-4">{description}</p>
  {technologies.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-4">
      {technologies.map((tech) => (
        <Badge variant="outline" class="text-xs">{tech}</Badge>
      ))}
    </div>
  )}
  <div class="flex flex-wrap gap-2 pt-4 border-t border-[var(--color-border)]">
    <a href={href} class="flex items-center gap-2 rounded-[var(--radius-md)] border border-[var(--color-border)] px-3 py-2 text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors">
      Case study
    </a>
    {githubUrl && (
      <a href={githubUrl} class="flex items-center gap-2 rounded-[var(--radius-md)] border border-[var(--color-border)] px-3 py-2 text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors" rel="noopener noreferrer" target="_blank">
        GitHub
      </a>
    )}
    {liveUrl && (
      <a href={liveUrl} class="flex items-center gap-2 rounded-[var(--radius-md)] border border-[var(--color-border)] px-3 py-2 text-sm text-[var(--color-fg-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors" rel="noopener noreferrer" target="_blank">
        Live demo
      </a>
    )}
  </div>
</article>
