---
interface Props {
  id?: string;
  class?: string;
  as?: 'section' | 'div' | 'article';
  [key: string]: any;
}

const { id, class: className = '', as = 'section', ...rest } = Astro.props;
const Tag = as;
---

<Tag id={id} class={['py-16 sm:py-20 lg:py-24', className].filter(Boolean).join(' ')} {...rest}>
  <slot />
</Tag>
