---
interface Props {
  code: string;
  id?: string;
  class?: string;
}

const { code, id = `mermaid-${Math.random().toString(36).slice(2, 8)}`, class: className = '' } = Astro.props;
---

<div class={['mermaid-wrapper', className].filter(Boolean).join(' ')} id={`wrapper-${id}`}>
  <div id={id} class="mermaid" aria-label="Diagram"></div>
</div>

<script>
  import mermaid from 'mermaid';

  const id = <%- JSON.stringify(id) %>;
  const code = <%- JSON.stringify(code) %>;

  function render() {
    const el = document.getElementById(id);
    if (!el) return;
    const theme = document.documentElement.classList.contains('light') ? 'default' : 'dark';
    mermaid.initialize({ startOnLoad: false, theme, securityLevel: 'loose' });
    mermaid.render(id, code).then(({ svg }) => {
      el.innerHTML = svg;
      el.setAttribute('aria-label', 'Diagram');
    });
  }

  if (typeof window !== 'undefined') {
    render();
    // Re-render on theme changes
    const observer = new MutationObserver(() => {
      const isLight = document.documentElement.classList.contains('light');
      const theme = isLight ? 'default' : 'dark';
      mermaid.initialize({ startOnLoad: false, theme, securityLevel: 'loose' });
      render();
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }
</script>
