---
import { experience } from '../../data/experience';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Badge from '../ui/Badge.astro';
---

<Section id="experience">
  <Container>
    <SectionHeading eyebrow="Experience" title="Professional background." description="Chronological, verified experience. Responsibilities are described conservatively and expanded only where implementation details are confirmed." />
    <ol class="mt-12 relative border-l border-[var(--color-border)] ml-2 space-y-10">
      {experience.map((entry) => (
        <li class="ml-6">
          <span class="absolute -left-[7px] mt-2 h-3.5 w-3.5 rounded-full border-2 border-[var(--color-bg)] bg-[var(--color-accent)]"></span>
          <div class="rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6">
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <h3 class="text-lg font-semibold text-[var(--color-fg)]">{entry.role}</h3>
                <p class="text-sm text-[var(--color-accent)]">{entry.organization}</p>
              </div>
              <Badge variant="muted">{entry.period}</Badge>
            </div>
            <p class="mt-3 text-sm text-[var(--color-fg-muted)] leading-relaxed">{entry.description}</p>
            {entry.responsibilities.length > 0 && (
              <ul class="mt-4 space-y-1.5 text-sm text-[var(--color-fg-muted)]">
                {entry.responsibilities.map((r) => (
                  <li class="flex gap-2">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent)]"></span>
                    <span>{r}</span>
                  </li>
                ))}
              </ul>
            )}
            {entry.technologies.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {entry.technologies.map((t) => (
                  <Badge variant="outline">{t}</Badge>
                ))}
              </div>
            )}
            {entry.links && entry.links.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-3">
                {entry.links.map((l) => (
                  <a href={l.url} class="text-sm text-[var(--color-accent)] hover:underline" rel="noopener noreferrer" target="_blank">
                    {l.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </Container>
</Section>
