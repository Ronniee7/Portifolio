---
import { profile } from '../../data/profile';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import SocialLinks from '../layout/SocialLinks.astro';
---
<Section id="contact">
  <Container>
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow="Contact" title="Get in touch." description="For software engineering, AI/ML, research collaboration, or technical project enquiries." />
        <div class="mt-6 space-y-4 text-sm text-[var(--color-fg-muted)]">
          {profile.email && (
            <p>
              Email: <a href={`mailto:${profile.email}`} class="text-[var(--color-accent)] hover:underline">{profile.email}</a>
            </p>
          )}
          {!profile.email && (
            <p class="text-[var(--color-fg-subtle)]">
              Professional email not yet configured. See <code class="mono">CONTENT_TODO.md</code>.
            </p>
          )}
          <div class="flex items-center gap-2">
            <SocialLinks />
          </div>
          <p class="text-xs text-[var(--color-fg-subtle)]">
            Location: {profile.location} (verify before relying on it).
          </p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <form id="contact-form" class="space-y-4 rounded-[var(--radius-xl)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6" novalidate>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="block text-sm font-medium text-[var(--color-fg)] mb-1">Name</label>
              <input id="contact-name" name="name" type="text" required autocomplete="name"
                class="w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3 py-2 text-sm text-[var(--color-fg)] focus:border-[var(--color-accent)] focus:outline-none" />
              <p class="mt-1 text-xs text-[var(--color-danger)] hidden" data-error-for="name">Please enter your name.</p>
            </div>
            <div>
              <label for="contact-email" class="block text-sm font-medium text-[var(--color-fg)] mb-1">Email</label>
              <input id="contact-email" name="email" type="email" required autocomplete="email"
                class="w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3 py-2 text-sm text-[var(--color-fg)] focus:border-[var(--color-accent)] focus:outline-none" />
              <p class="mt-1 text-xs text-[var(--color-danger)] hidden" data-error-for="email">Please enter a valid email address.</p>
            </div>
          </div>
          <div>
            <label for="contact-subject" class="block text-sm font-medium text-[var(--color-fg)] mb-1">Subject</label>
            <input id="contact-subject" name="subject" type="text" required
              class="w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3 py-2 text-sm text-[var(--color-fg)] focus:border-[var(--color-accent)] focus:outline-none" />
            <p class="mt-1 text-xs text-[var(--color-danger)] hidden" data-error-for="subject">Please enter a subject.</p>
          </div>
          <div>
            <label for="contact-message" class="block text-sm font-medium text-[var(--color-fg)] mb-1">Message</label>
            <textarea id="contact-message" name="message" rows="5" required
              class="w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3 py-2 text-sm text-[var(--color-fg)] focus:border-[var(--color-accent)] focus:outline-none"></textarea>
            <p class="mt-1 text-xs text-[var(--color-danger)] hidden" data-error-for="message">Please enter a message.</p>
          </div>

          <div class="hidden" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="flex items-center gap-3">
            <Button type="submit" variant="primary" size="md">Send message</Button>
            <p id="contact-status" class="text-sm" role="status" aria-live="polite"></p>
          </div>

          <p class="text-xs text-[var(--color-fg-subtle)]">
            This form uses a mailto action (no backend configured). For a working submission backend, configure a free form provider or Cloudflare Pages Function — see README and CONTENT_TODO.md.
          </p>
        </form>
      </div>
    </div>
  </Container>
</Section>
<script define:vars={{ contactEmail: profile.email }}>
  (function () {
    const form = document.getElementById('contact-form');
    const status = document.getElementById('contact-status');
    const email = contactEmail;

    function showError(field, show) {
      const el = form.querySelector('[data-error-for="' + field + '"]');
      if (el) el.classList.toggle('hidden', !show);
    }

    function validEmail(v) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') || '').trim();
      const fromEmail = String(data.get('email') || '').trim();
      const subject = String(data.get('subject') || '').trim();
      const message = String(data.get('message') || '').trim();
      const honeypot = String(data.get('website') || '').trim();

      if (honeypot) {
        status.textContent = 'Message not sent.';
        status.className = 'text-sm text-[var(--color-danger)]';
        return;
      }

      showError('name', !name);
      showError('email', !fromEmail || !validEmail(fromEmail));
      showError('subject', !subject);
      showError('message', !message);
      const ok = name && fromEmail && validEmail(fromEmail) && subject && message;

      if (!ok) {
        status.textContent = 'Please fix the highlighted fields.';
        status.className = 'text-sm text-[var(--color-danger)]';
        return;
      }

      if (!email) {
        status.textContent = 'Contact email is not configured yet. Please use the social links.';
        status.className = 'text-sm text-[var(--color-danger)]';
        return;
      }

      const body = encodeURIComponent('From: ' + name + ' <' + fromEmail + '>\n\n' + message);
      const mailto = 'mailto:' + email + '?subject=' + encodeURIComponent(subject) + '&body=' + body;
      window.location.href = mailto;
      status.textContent = 'Opening your email client…';
      status.className = 'text-sm text-[var(--color-success)]';
    });
  })();
</script>

