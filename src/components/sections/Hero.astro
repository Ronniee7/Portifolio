---
import { profile } from '../../data/profile';
import { socialLinks } from '../../data/social-links';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import SocialLinks from '../layout/SocialLinks.astro';
---

<section id="home" class="relative overflow-hidden">
  <div class="absolute inset-0 -z-10 opacity-60" aria-hidden="true">
    <div class="absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-[var(--color-accent-soft)] blur-3xl"></div>
  </div>
  <Container size="xl">
    <div class="grid min-h-[88vh] items-center gap-12 py-20 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <Badge variant="accent" class="mb-6 w-fit">
          {profile.availability}
        </Badge>
        <h1 class="display text-5xl sm:text-6xl lg:text-7xl text-[var(--color-fg)]">
          {profile.name}
        </h1>
        <p class="mt-4 text-xl sm:text-2xl text-[var(--color-fg-muted)]">
          {profile.headline}
        </p>
        <p class="mt-6 max-w-2xl text-base sm:text-lg text-[var(--color-fg-muted)] leading-relaxed">
          {profile.supporting}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/projects" variant="primary" size="lg">View projects</Button>
          <Button href="/research" variant="secondary" size="lg">Explore research</Button>
          <Button href={profile.cvUrl} variant="secondary" size="lg">Download CV</Button>
          <Button href="/#contact" variant="ghost" size="lg">Contact me</Button>
        </div>
        <div class="mt-10 flex items-center gap-4">
          <SocialLinks />
          {socialLinks.length === 0 && (
            <p class="text-sm text-[var(--color-fg-subtle)]">Social links will appear here once configured.</p>
          )}
        </div>
        <dl class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl">
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-fg-subtle)]">Affiliation</dt>
            <dd class="mt-1 text-sm text-[var(--color-fg)]">{profile.affiliation}</dd>
            <dd class="text-xs text-[var(--color-fg-muted)]">{profile.degree} · {profile.studyPeriod}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-fg-subtle)]">Location</dt>
            <dd class="mt-1 text-sm text-[var(--color-fg)]">{profile.location}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-widest text-[var(--color-fg-subtle)]">Focus</dt>
            <dd class="mt-1 text-sm text-[var(--color-fg)]">Reliable ML · Applied AI · Software</dd>
          </div>
        </dl>
      </div>
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative">
          <div class="absolute -inset-3 rounded-[var(--radius-2xl)] bg-[var(--color-accent-soft)]/40 blur-2xl" aria-hidden="true"></div>
          <img
            src={profile.photo}
            alt={`Portrait of ${profile.name}`}
            width="320"
            height="320"
            loading="eager"
            class="relative h-64 w-64 sm:h-80 sm:w-80 rounded-[var(--radius-2xl)] border border-[var(--color-border)] object-cover shadow-[var(--shadow-lg)]"
          />
          <p class="mt-3 text-center text-xs text-[var(--color-fg-subtle)]">
            Replace <code class="mono">public/images/profile/asiimwe-ronald.png</code> with a professional photograph.
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
